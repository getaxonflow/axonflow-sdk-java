<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.getaxonflow.examples</groupId>
    <artifactId>typed-policies</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>AxonFlow Java SDK — Typed Policy Authoring Example</name>
    <description>
        Typed policy authoring against a running AxonFlow v11 platform: what the deployment may
        author, validate, optionally publish and activate, and the document in force. Run mvn
        install on the SDK first to put the local artifact on the classpath.
    </description>

    <properties>
        <!-- release, not source/target: pins the API surface to 11 on every JDK. -->
        <maven.compiler.release>11</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.getaxonflow</groupId>
            <artifactId>axonflow-sdk</artifactId>
            <version>9.3.0</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- The default document, on the classpath, so the example runs from any directory. -->
            <resource>
                <directory>../../tests/fixtures</directory>
                <includes>
                    <include>typed_policy_publish_body.json</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>com.getaxonflow.examples.TypedPolicies</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
